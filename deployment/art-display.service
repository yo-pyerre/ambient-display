[Unit]
Description=Raspberry Pi Art Display Backend
After=network.target

[Service]
Type=simple
User=taiden
ExecStart=/home/taiden/scripts/start-art-display-service.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
